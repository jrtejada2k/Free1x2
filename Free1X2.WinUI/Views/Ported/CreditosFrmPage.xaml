<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Free1X2.WinUI.Views.Ported.CreditosFrmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Free1X2.WinUI.Views.Ported"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer Padding="{StaticResource AppPagePadding}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center" MaxWidth="560" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado: título real del form -->
            <StackPanel Grid.Row="0" Spacing="6">
                <!-- U-10: textos migrados a x:Uid + Strings\{es,en-US}\Resources.resw.
                     El AutomationProperties.Name se localiza vía la clave attached-property del
                     .resw; se conserva el literal en español como fallback de diseño (si la clave
                     no resolviera, no habría regresión de accesibilidad respecto a U-12). -->
                <HyperlinkButton x:Name="WebsiteLink"
                                 x:Uid="CreditosWebsiteLink"
                                 Padding="0"
                                 Click="OnWebsiteClick"
                                 AutomationProperties.Name="Visitar el sitio web clubprogol.com">
                    <TextBlock x:Uid="CreditosTituloEquipo"
                               Style="{StaticResource PageTitleTextBlockStyle}" />
                </HyperlinkButton>
                <TextBlock x:Uid="CreditosWebUrl"
                           Style="{StaticResource SecondaryTextBlockStyle}" />
            </StackPanel>

            <!-- Card con la lista de colaboradores -->
            <Border Grid.Row="1" Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="CreditosColaboradores"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <ItemsControl x:Name="CreditsList" ItemsSource="{x:Bind Creditos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CreditoEntrada">
                                <Grid Padding="0,2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind Nombre}"
                                               Style="{StaticResource CardTitleTextBlockStyle}" />

                                    <!-- Contacto de tercero: email ofuscado en texto plano, NO clicable. -->
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind VisibilidadTexto}"
                                               Text="{x:Bind Contacto}"
                                               IsTextSelectionEnabled="False"
                                               Style="{StaticResource SecondaryTextBlockStyle}" />

                                    <!-- Contacto clicable (mailto:): sólo para entradas intencionales. -->
                                    <HyperlinkButton Grid.Column="1"
                                                     Visibility="{x:Bind VisibilidadEnlace}"
                                                     Content="{x:Bind Contacto}"
                                                     NavigateUri="{x:Bind Uri}"
                                                     AutomationProperties.Name="{x:Bind ContactoAccesible}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Nota de agradecimiento (lnkBtesters) -->
            <Border Grid.Row="2" Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Uid="CreditosGraciasNota"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Style="{StaticResource SecondaryTextBlockStyle}" />
                    <TextBlock x:Uid="CreditosGracias"
                               TextAlignment="Center"
                               Style="{StaticResource CardTitleTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
