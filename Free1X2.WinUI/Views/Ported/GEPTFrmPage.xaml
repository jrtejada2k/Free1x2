<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Free1X2.WinUI.Views.Ported.GEPTFrmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Free1X2.WinUI.Views.Ported"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="10,7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock
                Text="Columna estadística de ABDON (GEPT)"
                Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock
                Text="En la 1.ª columna, el último resultado de liga de cada equipo local; en la 2.ª, el de cada visitante (G = Ganó, E = Empató, P = Perdió). Calcular da el pronóstico."
                Style="{StaticResource SecondaryTextBlockStyle}" />
        </StackPanel>

        <!-- Tarjeta de la columna. Dentro de un ScrollViewer: con 14 partidos no cabía en una
             ventana de 760 px de alto y las últimas filas quedaban fuera, sin forma de verlas. -->
        <ScrollViewer Grid.Row="1">
        <Border
            Style="{StaticResource AppCardStyle}"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            MaxWidth="520">
            <StackPanel Spacing="6">

                <!-- Cabecera de columnas: como el legacy, una sola etiqueta «Última vez» sobre el nº y
                     las dos columnas de entrada (label1, GEPTFrm.cs:228-234) y «Pronóstico» (label7). -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Center"
                        Text="Última vez"
                        Style="{StaticResource CardTitleTextBlockStyle}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="Pronóstico"
                        Style="{StaticResource CardTitleTextBlockStyle}" />
                </Grid>

                <!-- Filas de partidos -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Partidos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:GEPTFila">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind NumeroTexto}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <!-- Cajas de texto como el legacy (rechazan otra letra con «Las letras
                                     permitidas son: G,E,P»). Recolor legacy (Verificar): G verde /
                                     E amarillo / P rosa; el borde toma el color de fondo de la celda. -->
                                <Border
                                    Grid.Column="1"
                                    Background="{x:Bind FondoPrimera, Mode=OneWay}"
                                    CornerRadius="6">
                                    <TextBox
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        Background="Transparent"
                                        Text="{x:Bind Primera, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Último resultado del equipo local (G/E/P)" />
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Background="{x:Bind FondoSegunda, Mode=OneWay}"
                                    CornerRadius="6">
                                    <TextBox
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        Background="Transparent"
                                        Text="{x:Bind Segunda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Último resultado del equipo visitante (G/E/P)" />
                                </Border>
                                <Border
                                    Grid.Column="3"
                                    Background="{ThemeResource AppSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinHeight="32"
                                    Padding="8,0">
                                    <TextBlock
                                        Text="{x:Bind Resultado, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Acciones -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="5"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
                    <Button
                        Content="Calcular"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.CalcularCommand}"
                        AutomationProperties.Name="Calcular pronóstico de la columna GEPT" />
                </StackPanel>

            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</Page>
