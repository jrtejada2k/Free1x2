<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Free1X2.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- Sin barra de título custom: se usa la barra de Windows estándar
         (minimizar / maximizar / cerrar) como el MainForm WinForms original. -->
    <!-- Raíz del contenido de la ventana: es el elemento sobre el que Services/TemaApp fija
         RequestedTheme (Light / Dark / Default = seguir a Windows). Ver U-01. -->
    <Grid x:Name="RaizVentana" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de menús (organización del programa original) -->
        <muxc:MenuBar x:Name="BarraMenu" Grid.Row="0" />

        <!-- W8 (DT-82): panel lateral con las pantallas por nombre, agrupadas y con buscador, en
             lugar de los 55 iconos que solo decían su función en un tooltip. Plegable. -->
        <muxc:NavigationView x:Name="PanelLateral" Grid.Row="1"
                             PaneDisplayMode="Left"
                             OpenPaneLength="240"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             IsTitleBarAutoPaddingEnabled="False"
                             ItemInvoked="PanelLateral_ItemInvoked">
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="BuscadorPantallas"
                                PlaceholderText="Buscar pantalla"
                                QueryIcon="Find"
                                TextChanged="BuscadorPantallas_TextChanged"
                                QuerySubmitted="BuscadorPantallas_QuerySubmitted"
                                AutomationProperties.Name="Buscar pantalla" />
            </muxc:NavigationView.AutoSuggestBox>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra con las acciones frecuentes CON TEXTO. Nueva, Abrir y Guardar solo con
                     icono (y tooltip) para que quepa en 1024 px; Inicio añade las suyas. -->
                <CommandBar x:Name="BarraAcciones" Grid.Row="0"
                            HorizontalAlignment="Left"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            Background="{ThemeResource AppSurfaceAltBrush}">
                    <AppBarButton x:Name="BotonCalcular" Label="Calcular"
                                  ToolTipService.ToolTip="Calcular las columnas del boleto"
                                  Click="BotonCalcular_Click">
                        <AppBarButton.Icon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Toolbar/bCalcular.png" ShowAsMonochrome="False" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="BotonReducir" Label="Reducir"
                                  ToolTipService.ToolTip="Abrir el Reductor"
                                  Click="BotonReducir_Click">
                        <AppBarButton.Icon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Toolbar/bReducir.png" ShowAsMonochrome="False" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="BotonJornada" Label="Jornada"
                                  ToolTipService.ToolTip="Cargar los equipos de la jornada actual">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE787;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="España" Tag="es" Click="Jornada_Click" />
                                <MenuFlyoutItem Text="México" Tag="mx" Click="Jornada_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarSeparator x:Name="SeparadorInicio" />
                    <AppBarButton Label="Nueva" LabelPosition="Collapsed"
                                  ToolTipService.ToolTip="Nueva combinación"
                                  AutomationProperties.Name="Nueva combinación"
                                  Click="BotonNueva_Click">
                        <AppBarButton.Icon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Toolbar/bNuevo.png" ShowAsMonochrome="False" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Abrir" LabelPosition="Collapsed"
                                  ToolTipService.ToolTip="Abrir combinación"
                                  AutomationProperties.Name="Abrir combinación"
                                  Click="BotonAbrir_Click">
                        <AppBarButton.Icon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Toolbar/bAbrirCombinacion.png" ShowAsMonochrome="False" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Guardar" LabelPosition="Collapsed"
                                  ToolTipService.ToolTip="Guardar combinación"
                                  AutomationProperties.Name="Guardar combinación"
                                  Click="BotonGuardar_Click">
                        <AppBarButton.Icon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Toolbar/bGuardarCombinacion.png" ShowAsMonochrome="False" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Escrutinio"
                                  ToolTipService.ToolTip="Escrutinio"
                                  Click="BotonEscrutinio_Click">
                        <AppBarButton.Icon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Toolbar/bEscrutinio.png" ShowAsMonochrome="False" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <!-- Contenido -->
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="ContentFrame_Navigated" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
