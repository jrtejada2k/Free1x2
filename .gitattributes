# Normalización de fin de línea para todo el repositorio.
# Git decide automáticamente qué archivos son texto y normaliza a LF en el repo.
* text=auto

# Tipos de código fuente: siempre tratados como texto.
*.cs       text
*.xaml     text
*.csproj   text
*.sln      text
*.ps1      text
*.md       text
*.xml      text
*.json     text
*.resx     text

# Archivos binarios: nunca normalizar ni hacer diff de texto.
*.png      binary
*.ico      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.dll      binary
*.exe      binary
*.comb     binary

# Históricos de fábrica del Mac (DT-96): CRLF como en la distribución original, en cualquier checkout.
Free1X2.Mac/App/Recursos/Datos/Jornadas/*.txt text eol=crlf
Free1X2.Mac/App/Recursos/Datos/Ganadoras/*.txt text eol=crlf
Free1X2.Mac/App/Recursos/Datos/Jornadas/*.csv text eol=crlf

# Mismos históricos en el WinUI (W20–W22): CRLF como en la distribución original, en cualquier checkout.
Free1X2.WinUI/Datos/Semillas/Jornadas/*.txt text eol=crlf
Free1X2.WinUI/Datos/Semillas/Ganadoras/*.txt text eol=crlf
Free1X2.WinUI/Datos/Semillas/Jornadas/*.csv text eol=crlf
